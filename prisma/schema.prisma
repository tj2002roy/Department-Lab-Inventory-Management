datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String          @id @default(uuid())
  username        String          @unique // Unique login identifier for Admin / Teachers
  password        String          // Password hash (salted)
  name            String
  email           String          @unique
  role            String          @default("TEACHER") // ADMIN (HOD), TEACHER (Lab In-Charge), AUDITOR
  designation     String?         // Head of Department, Faculty, Coordinator, Technical Staff
  prefix          String?         // Prof., Dr., Mr., Ms., Mrs.
  firstName       String?
  middleName      String?
  lastName        String?
  employeeCode    String?         @unique
  contactNumber   String?
  position        String?         // Faculty | Staff
  labAssignments  LabAssignment[]
  activityLogs    ActivityLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("users")
}

model Lab {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  workingPcs      Int             @default(0)
  inactivePcs     Int             @default(0)
  systems         System[]
  items           Item[]
  assignments     LabAssignment[]
  sourceLogs      ActivityLog[]   @relation("FromLab")
  targetLogs      ActivityLog[]   @relation("ToLab")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("labs")
}

model LabAssignment {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId        String
  lab          Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  assignedById String?   // HOD user who authorized this assignment
  assignedAt   DateTime  @default(now())

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
  @@map("lab_assignments")
}

model System {
  id           String        @id @default(uuid())
  unique_id    String        @unique // e.g., SYS-DL-001
  name         String
  status       String        @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, DECOMMISSIONED
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id], onDelete: Restrict)
  items        Item[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([labId])
  @@index([unique_id])
  @@map("systems")
}

model Item {
  id           String        @id @default(uuid())
  qr_uuid      String        @unique @default(uuid()) // Static UUID for QR code resolution
  name         String
  category     String        // Monitor, Keyboard, CPU, Chair, Spectrophotometer, etc.
  attributes   String        @default("{}") // Dynamic JSON specifications, serial numbers, condition
  systemId     String?
  system       System?       @relation(fields: [systemId], references: [id], onDelete: SetNull)
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id], onDelete: Restrict)
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([qr_uuid])
  @@index([labId])
  @@index([systemId])
  @@map("items")
}

model ActivityLog {
  id           String      @id @default(uuid())
  itemId       String?
  item         Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  systemId     String?
  system       System?     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?     // Persists the actor name even if user is removed
  action_type  String      // UPDATE, MOVE, COMMENT, CREATE_FACULTY, EDIT_FACULTY, DELETE_FACULTY, CREATE_LAB, EDIT_LAB, DELETE_LAB, PASSWORD_CHANGE
  fromLabId    String?
  fromLab      Lab?        @relation("FromLab", fields: [fromLabId], references: [id], onDelete: SetNull)
  toLabId      String?
  toLab        Lab?        @relation("ToLab", fields: [toLabId], references: [id], onDelete: SetNull)
  comment_text String?
  timestamp    DateTime    @default(now())

  @@index([itemId])
  @@index([systemId])
  @@index([userId])
  @@index([timestamp])
  @@map("activity_logs")
}

